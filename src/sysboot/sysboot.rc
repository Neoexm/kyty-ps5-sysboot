#include <windows.h>
#include "resource.h"

IDR_MENU MENU
BEGIN
	POPUP "&File"
	BEGIN
		MENUITEM "&Boot sys", IDM_BOOT
		MENUITEM "&Stop sys", IDM_STOP
		MENUITEM "&Reset console state...", IDM_RESET_STATE
		MENUITEM SEPARATOR
		MENUITEM "&Preferences...", IDM_PREFERENCES
		MENUITEM SEPARATOR
		MENUITEM "E&xit", IDM_EXIT
	END
	POPUP "&View"
	BEGIN
		MENUITEM "&Log", IDM_LOG
	END
END

IDD_PREFERENCES DIALOGEX 0, 0, 322, 121
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Preferences"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
	LTEXT "Boot uses saved console data. No PS5 connection is needed.", -1, 8, 10, 306, 8
	LTEXT "Repository folder:", -1, 8, 28, 78, 8
	EDITTEXT IDC_REPO, 90, 26, 172, 12, ES_AUTOHSCROLL
	PUSHBUTTON "Browse...", IDC_REPO_BROWSE, 266, 25, 48, 14
	LTEXT "Leave blank to search upwards from kyty_sysboot.exe.", -1, 90, 42, 224, 8
	AUTOCHECKBOX "Write present readbacks", IDC_READBACKS, 90, 60, 200, 10
	AUTOCHECKBOX "Show service windows", IDC_SHOW_SERVICES, 90, 74, 200, 10
	PUSHBUTTON "Reset console state...", IDC_RESET_STATE, 8, 99, 112, 14
	DEFPUSHBUTTON "OK", IDOK, 212, 99, 50, 14
	PUSHBUTTON "Cancel", IDCANCEL, 266, 99, 48, 14
END
